#!/usr/bin/env python3
"""polarbench command line.

  ./polarbench ui                                   dashboard at http://localhost:8800
  ./polarbench autopilot record|run|list|show|rollback|demo   saved workflows (see -h)
  ./polarbench run --agent gemini --guards all      run tasks (see ./polarbench run -h)
  ./polarbench report runs/<dir>                    build runs/<dir>/report/index.html
  ./polarbench compare runs/a runs/b --out docs/x   side-by-side page
  ./polarbench serve --port 5055                    just the test site (bring your own browser)
  ./polarbench tasks                                list tasks
  ./polarbench gate runs/<dir> --min-pass-rate 0.9  exit 1 below the bar (CI)
"""
import argparse
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, rest = sys.argv[1], sys.argv[2:]
    if cmd == "autopilot":
        from autopilot.cli import main as ap_main
        ap_main(rest)
        return
    if cmd == "run":
        from runner.run import main as run_main
        return run_main(rest)
    if cmd == "report":
        ap = argparse.ArgumentParser(prog="polarbench report")
        ap.add_argument("run_dir")
        ap.add_argument("--reference")
        a = ap.parse_args(rest)
        from report.build import build
        print(build(a.run_dir, a.reference))
        return
    if cmd == "compare":
        sys.argv = ["compare"] + rest
        from report.compare import main as cmp_main
        return cmp_main()
    if cmd == "serve":
        ap = argparse.ArgumentParser(prog="polarbench serve")
        ap.add_argument("--port", type=int, default=5055)
        ap.add_argument("--db", default=os.path.join(ROOT, "site", "pipeline.db"))
        ap.add_argument("--tasks-file")
        a = ap.parse_args(rest)
        env = dict(os.environ, PORT=str(a.port), POLARBENCH_DB=a.db)
        if a.tasks_file:
            env["POLARBENCH_TASKS_FILE"] = os.path.abspath(a.tasks_file)
        print(f"Pipeline test site on http://127.0.0.1:{a.port}  (POST /api/episode/start to begin)")
        return subprocess.call([sys.executable, os.path.join(ROOT, "site", "app.py")], env=env, cwd=os.path.join(ROOT, "site"))
    if cmd == "ui":
        ap = argparse.ArgumentParser(prog="polarbench ui")
        ap.add_argument("--port", type=int, default=8800)
        ap.add_argument("--workflows", help="workflow store folder (default: workflows/)")
        a = ap.parse_args(rest)
        from ui.app import serve
        return serve(a.port, a.workflows)
    if cmd == "tasks":
        from tasks.tasks import TASKS
        for t in TASKS:
            print(f"{t.id:26s} {t.prompt}")
        return
    if cmd == "gate":
        ap = argparse.ArgumentParser(prog="polarbench gate")
        ap.add_argument("run_dir")
        ap.add_argument("--min-pass-rate", type=float, required=True)
        a = ap.parse_args(rest)
        rows = [json.loads(l) for l in open(os.path.join(a.run_dir, "results.jsonl"))]
        rate = sum(r["passed"] for r in rows) / max(1, len(rows))
        print(f"{sum(r['passed'] for r in rows)}/{len(rows)} passed ({rate:.0%}), gate {a.min_pass_rate:.0%}")
        sys.exit(0 if rate >= a.min_pass_rate else 1)
    print(f"unknown command {cmd!r}\n{__doc__}")
    sys.exit(2)


if __name__ == "__main__":
    sys.exit(main() or 0)
